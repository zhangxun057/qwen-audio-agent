# hotel-direct 分享版最小配置
# 请复制到本机 ~/.config/qwaudio/config.env 后填写，不要提交填写后的文件。

# Qwen Audio Realtime API Key：由分享者私下提供，禁止写入仓库。
DASHSCOPE_API_KEY=<your-dashscope-api-key>
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus

# 酒店任务直接由 Gateway 调用，不需要 DSH 或后台 Agent。
AGENT_PROTOCOL=none
QWEN_AUDIO_AGENT_TOOL_PROFILE=hotel-direct

# 当前业务用户身份：必须填写接收方自己的值。
QWEN_AUDIO_CONTEXT_MODE=mock
QWEN_AUDIO_CONTEXT_ID=<daily-context-id>
QWEN_AUDIO_CONTEXT_USER_ID=<business-user-id>

# Spirit 任务 API：必须填写接收方自己的地址和 Token。
SPIRIT_API_BASE_URL=<spirit-api-base-url>
SPIRIT_BEARER_TOKEN=<spirit-api-token>

# 正式 Context Service 接入时，将上面的 mock 改成 http，并填写：
# QWEN_AUDIO_CONTEXT_MODE=http
# QWEN_AUDIO_CONTEXT_SERVICE_URL=<context-service-url>
# QWEN_AUDIO_CONTEXT_SERVICE_TOKEN=<context-service-token>
# QWEN_AUDIO_CONTEXT_FALLBACK_TO_MOCK=false
