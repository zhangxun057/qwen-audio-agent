{
  "version": 2,
  "tenantScope": "hotel-10082",
  "models": {
    "room": { "kind": "static", "idRule": "compose" },
    "item": { "kind": "static", "idRule": "lookup" },
    "employee": { "kind": "static", "idRule": "lookup" },
    "stay": { "kind": "dynamic", "operation": "search_instances" },
    "order": { "kind": "dynamic", "operation": "search_instances" },
    "guest": { "kind": "dynamic", "operation": "search_instances" },
    "location": { "kind": "open_world", "idRule": "compose_or_unresolved" },
    "event": { "kind": "appendable", "operation": "write_instance" }
  },
  "idRules": {
    "room": {
      "mode": "compose",
      "template": "room:{roomNumber}",
      "normalize": "digits_3_or_4"
    },
    "item": { "mode": "lookup", "allowUnregistered": true, "fallback": "item:unresolved:{stableToken}" },
    "stay": { "mode": "lookup" },
    "order": { "mode": "lookup" },
    "location": {
      "mode": "compose_or_unresolved",
      "floorAreaTemplate": "location:floor-{floor}:{area}",
      "fallback": "location:unresolved:{stableToken}"
    }
  },
  "writeContracts": {
    "event": {
      "schemaVersion": "event.v2",
      "minimumInput": ["category", "content"],
      "traceableEntityPolicy": {
        "genericMentions": {
          "room": ["房间", "客房", "这个房间", "那个房间"],
          "stay": ["住店记录", "入住记录", "本次住店", "这次入住"],
          "order": ["订单", "这张订单", "那个订单", "携程订单", "美团订单", "平台订单", "OTA订单"],
          "guest": ["客人", "客户", "住客", "这个客人", "那位客人", "有人"]
        }
      },
      "categories": {
        "物品": {
          "meaning": "物品的送出、消耗、借还、售卖、库存结果和拾获交存",
          "suggestedActions": ["送出", "消耗", "借出", "归还", "售出", "库存核实", "库存调整", "拾获", "交存"],
          "suggestedFacts": ["itemName", "quantity", "unit", "location", "sourceLocation", "targetLocation", "amount", "currency", "condition", "reason"],
          "actionRules": {
            "借出": {
              "aliases": ["借用", "外借", "借给"],
              "requiredFacts": ["itemName", "quantity", "unit"],
              "anyEntityTypes": ["room", "stay", "guest", "employee"],
              "clarification": "请补充借出的物品、数量，以及借给谁。",
              "questions": {
                "facts": {
                  "itemName": "借出的是什么物品？",
                  "quantity": "借出了多少？",
                  "unit": "借出数量的单位是什么？"
                },
                "factsCombined": "借出的是什么物品，数量是多少？",
                "entity": "借给哪个房间、哪位客人或哪位员工？",
                "combined": "借出的是什么、多少，借给谁？"
              }
            }
          }
        },
        "客人": {
          "meaning": "客人的投诉、要求、报失、偏好和本次住店事实",
          "suggestedActions": ["投诉", "要求", "报失", "偏好", "住店变化", "服务结果"],
          "suggestedFacts": ["statement", "request", "preference", "objectName", "location", "result", "reason"],
          "actionRules": {
            "投诉": {
              "aliases": ["客诉"],
              "requiredFacts": ["statement"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "anyEntityRoles": ["complainant"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要能够定位具体投诉人的线索；结合已经知道的渠道、时间和投诉内容，只追问一个最容易补充的信息",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "要求": {
              "aliases": ["住店要求", "需求"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道这项要求属于哪位可追踪客人或哪次住店",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "报失": {
              "aliases": ["遗失报告", "丢失"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道是哪位客人报告遗失，方便后续联系和查询",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "偏好": {
              "aliases": ["住店偏好"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道这项偏好属于哪位客人或哪次住店",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "住店变化": {
              "aliases": ["换房", "续住", "提前退房"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道发生变化的是哪位客人或哪次住店",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "服务结果": {
              "aliases": ["服务完成", "服务反馈"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道这次服务结果属于哪位客人或哪次住店",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "寄存": {
              "aliases": ["行李寄存"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道是谁寄存的，确保后续能够核验领取人",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            },
            "预留": {
              "aliases": ["预订保留"],
              "anyEntityTypes": ["room", "stay", "order", "guest"],
              "requireTraceableEntity": true,
              "clarificationGuidance": "还需要知道这项预留属于哪位客人或哪次住店",
              "entityHints": ["房号", "客人姓名", "具体订单号", "入住日期"]
            }
          }
        },
        "酒店": {
          "meaning": "房间设施、公共区域、交通天气、班次交接等影响酒店运行的已发生事实",
          "suggestedActions": ["异常报告", "故障核实", "运行变化", "交接", "恢复"],
          "suggestedFacts": ["observation", "location", "scope", "result", "reason", "validFrom", "validUntil"]
        },
        "其他": {
          "meaning": "不适合前三类或当下无法稳定分类的事实",
          "suggestedActions": [],
          "suggestedFacts": [],
          "allowEmptyFacts": true,
          "allowEmptyEntities": true,
          "allowAdditionalFacts": true
        }
      }
    }
  },
